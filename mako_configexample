 
[app-name="soundcloud"]
anchor=top-center
margin=10
width=330
height=72
padding=8,14
border-radius=24
border-size=1
border-color=#d09fff33
background-color=#14121dbf
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=14
font=JetBrains Mono 9.5
text-alignment=left
text-color=#ffffff
markup=true
format=<span size="9000" foreground="#ccaefc">%s</span>\n<span font_weight="bold" size="10000" foreground="#ffffff">%b</span>
progress-color=over #b490fe44
